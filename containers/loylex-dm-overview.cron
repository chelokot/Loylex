SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/home/loylex
LOYLEX_BRIDGE_URL=http://loylex-gateway:8787
LOYLEX_BRIDGE_TOKEN_FILE=/run/secrets/loylex-bridge-token
LOYLEX_REPOSITORY_PATH=/workspace/Loylex
LOYLEX_MEMORY_PATH=/memory
CRON_TZ=Etc/UTC

0 * * * * loylex /usr/bin/mkdir -p /home/loylex/.local/state/loylex && /usr/bin/flock -n /home/loylex/.local/state/loylex/telegram-dm-overview.lock /usr/local/bin/loylex-dm-overview >>/home/loylex/.local/state/loylex/telegram-dm-overview.log 2>&1
