#!/usr/bin/env python3

import hmac
import json
import os
import subprocess
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any


LISTEN_HOST = os.environ.get("LOYLEX_SUPERVISOR_LISTEN_HOST", "0.0.0.0")
LISTEN_PORT = int(os.environ.get("LOYLEX_SUPERVISOR_LISTEN_PORT", "8790"))
TOKEN_PATH = Path(
    os.environ.get("LOYLEX_SUPERVISOR_TOKEN_FILE", str(Path.home() / ".config/loylex/supervisor-token"))
)
STATE_PATH = Path(
    os.environ.get(
        "LOYLEX_SUPERVISOR_STATE_FILE",
        str(Path.home() / ".local/state/loylex-supervisor/state.json"),
    )
)
STACK_DIRECTORY = Path(
    os.environ.get("LOYLEX_PM3_STACK_DIRECTORY", str(Path.home() / "stack"))
)
COMPOSE_FILE = STACK_DIRECTORY / "compose.yaml"
PM3_BINARY = os.environ.get("LOYLEX_PM3_BINARY", "pm3")
IMAGE_REPOSITORIES = {
    "agent": "ghcr.io/chelokot/loylex-agent",
    "gateway": "ghcr.io/chelokot/loylex-gateway",
}
PM3_PROJECTS = {
    "gateway": "loylex-gateway",
    "blue": "loylex-worker-blue",
    "green": "loylex-worker-green",
}
CONTAINER_NAMES = {
    "gateway": "loylex-gateway",
    "blue": "loylex-agent-blue",
    "green": "loylex-agent-green",
}
COMPOSE_SERVICES = {
    "gateway": "gateway",
    "blue": "agent-blue",
    "green": "agent-green",
}
SERVICE_COMPONENTS = {
    "agent": ("blue", "green"),
    "gateway": ("gateway",),
}
AGENT_SLOTS = ("blue", "green")
ACTIVE_CONTAINER_STATES = {"active", "activating"}
AGENT_MEMORY_SWAP_LIMIT = "13g"
AGENT_DRAIN_TIMEOUT_SECONDS = 360
HEALTH_TIMEOUT_SECONDS = 600


class SupervisorError(Exception):
    pass


class BusyError(SupervisorError):
    pass


def run_command(command: list[str], timeout: int = 900, cwd: Path | None = None) -> str:
    result = subprocess.run(
        command,
        check=False,
        capture_output=True,
        text=True,
        timeout=timeout,
        cwd=cwd,
    )
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit code {result.returncode}"
        raise SupervisorError(f"{command[0]} failed: {detail}")
    return result.stdout.strip()


def replace_image_line(content: str, repository: str, reference: str) -> str:
    """Keep the old Quadlet helper available for callers and migration tests."""
    expected_prefix = f"Image={repository}"
    matching = [line for line in content.splitlines() if line.startswith(expected_prefix)]
    if len(matching) != 1:
        raise SupervisorError(f"Expected exactly one {expected_prefix} line")
    lines = [f"Image={reference}" if line.startswith(expected_prefix) else line for line in content.splitlines()]
    return "\n".join(lines) + "\n"


def replace_compose_image_line(content: str, service: str, repository: str, reference: str) -> str:
    """Replace one image in one top-level Compose service, without touching other slots."""
    lines = content.splitlines()
    services_index = next((index for index, line in enumerate(lines) if line == "services:"), None)
    if services_index is None:
        raise SupervisorError("Compose file has no services section")

    service_header = f"  {service}:"
    service_indexes = [index for index in range(services_index + 1, len(lines)) if lines[index] == service_header]
    if len(service_indexes) != 1:
        raise SupervisorError(f"Expected exactly one Compose service: {service}")
    service_index = service_indexes[0]

    service_end = len(lines)
    for index in range(service_index + 1, len(lines)):
        if lines[index] and not lines[index].startswith("   "):
            service_end = index
            break

    expected_images: list[int] = []
    for index in range(service_index + 1, service_end):
        line = lines[index]
        if not line.startswith("    image:"):
            continue
        value = line[len("    image:"):].strip()
        if value == repository or value.startswith(f"{repository}:") or value.startswith(f"{repository}@"):
            expected_images.append(index)
    if len(expected_images) != 1:
        raise SupervisorError(f"Expected exactly one image for {service} using {repository}")

    lines[expected_images[0]] = f"    image: {reference}"
    return "\n".join(lines) + "\n"


def selected_components(scope: str) -> list[str]:
    if scope == "all":
        return ["gateway", "agent"]
    if scope in SERVICE_COMPONENTS:
        return [scope]
    raise SupervisorError(f"Unsupported scope: {scope}")


def service_state(component: str) -> str:
    """Translate the exact managed container's Podman state to the API state vocabulary."""
    container = CONTAINER_NAMES.get(component)
    if container is None:
        raise SupervisorError(f"Unsupported service: {component}")
    result = subprocess.run(
        ["podman", "inspect", "--format", "{{.State.Status}}", container],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return "inactive"
    state = result.stdout.strip()
    if state == "running":
        return "active"
    if state in {"created", "configured", "paused", "restarting", "stopping"}:
        return "activating"
    return "inactive"


class Supervisor:
    def __init__(self) -> None:
        self.lock = threading.Lock()
        self.worker: threading.Timer | None = None
        previous_state: dict[str, Any] = {}
        try:
            loaded = json.loads(STATE_PATH.read_text())
            if isinstance(loaded, dict):
                previous_state = loaded
        except (OSError, json.JSONDecodeError):
            pass
        saved_slot = previous_state.get("activeAgentSlot")
        self.active_agent_slot: str | None = saved_slot if saved_slot in AGENT_SLOTS else None
        self.state: dict[str, Any] = {
            "state": "idle",
            "operation": None,
            "scope": None,
            "updatedAt": int(time.time()),
            "activeAgentSlot": self.active_agent_slot,
        }
        self._write_state()

    def status(self) -> dict[str, Any]:
        services = {"gateway": service_state("gateway")}
        for slot in AGENT_SLOTS:
            services[f"agent-{slot}"] = service_state(slot)
        try:
            active_slot = self._current_agent_slot()
        except SupervisorError:
            active_slot = None
        services["agent"] = (
            service_state(active_slot) if active_slot is not None else "inactive"
        )
        with self.lock:
            operation = dict(self.state)
        return {
            "services": services,
            "agentSlot": active_slot,
            "pm3Projects": dict(PM3_PROJECTS),
            "operation": operation,
        }

    def schedule(self, operation: str, scope: str, delay_seconds: int) -> dict[str, Any]:
        selected_components(scope)
        if operation not in {"restart", "deploy"}:
            raise SupervisorError(f"Unsupported operation: {operation}")
        if delay_seconds < 5 or delay_seconds > 300:
            raise SupervisorError("delaySeconds must be between 5 and 300")
        with self.lock:
            if self.worker is not None and self.worker.is_alive():
                raise BusyError("Another supervisor operation is already active")
            self.state = {
                "state": "scheduled",
                "operation": operation,
                "scope": scope,
                "updatedAt": int(time.time()),
                "activeAgentSlot": self.active_agent_slot,
            }
            self._write_state()
            self.worker = threading.Timer(delay_seconds, self._execute, args=(operation, scope))
            self.worker.daemon = True
            self.worker.start()
            return dict(self.state)

    def _execute(self, operation: str, scope: str) -> None:
        self._set_state("running", operation, scope)
        try:
            if operation == "deploy":
                self._deploy(scope)
            else:
                self._restart(scope)
            self._set_state("succeeded", operation, scope)
        except Exception as error:
            self._set_state("failed", operation, scope, str(error))

    @staticmethod
    def _atomic_write(path: Path, content: str, suffix: str = ".new") -> None:
        temporary = path.with_name(f"{path.name}{suffix}")
        temporary.write_text(content)
        os.replace(temporary, path)

    @staticmethod
    def _try_command(command: list[str], timeout: int = 900, cwd: Path | None = None) -> None:
        subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
            cwd=cwd,
        )

    def _run_pm3(self, arguments: list[str], timeout: int = 900) -> str:
        if not COMPOSE_FILE.is_file():
            raise SupervisorError(f"Missing PM3 Compose file: {COMPOSE_FILE}")
        return run_command([PM3_BINARY, *arguments], timeout=timeout, cwd=STACK_DIRECTORY)

    @staticmethod
    def _project(component: str) -> str:
        try:
            return PM3_PROJECTS[component]
        except KeyError as error:
            raise SupervisorError(f"Unsupported PM3 component: {component}") from error

    def _current_agent_slot(self) -> str | None:
        saved_slot = self.active_agent_slot
        running_slots = [
            slot for slot in AGENT_SLOTS if service_state(slot) in ACTIVE_CONTAINER_STATES
        ]
        if saved_slot in AGENT_SLOTS:
            if service_state(saved_slot) in ACTIVE_CONTAINER_STATES:
                return saved_slot
            if len(running_slots) == 1:
                self.active_agent_slot = running_slots[0]
                return running_slots[0]
            return saved_slot
        if len(running_slots) == 1:
            self.active_agent_slot = running_slots[0]
            return running_slots[0]
        if len(running_slots) > 1:
            raise SupervisorError("Both agent slots are active but no active slot is recorded")
        return None

    def _current_agent_container(self) -> str:
        slot = self._current_agent_slot()
        if slot is None:
            raise SupervisorError("No active agent slot is available")
        return CONTAINER_NAMES[slot]

    def _inactive_agent_slot(self) -> str:
        current = self._current_agent_slot()
        candidates = list(AGENT_SLOTS) if current is None else [slot for slot in AGENT_SLOTS if slot != current]
        for slot in candidates:
            if service_state(slot) not in ACTIVE_CONTAINER_STATES:
                return slot
        raise SupervisorError("No inactive agent slot is available; the draining slot may still be running")

    def _check_agent(self) -> None:
        run_command(["podman", "exec", self._current_agent_container(), "bun", "run", "check"])

    @staticmethod
    def _apply_agent_resource_limits(slot: str) -> None:
        run_command(
            ["podman", "update", "--memory-swap", AGENT_MEMORY_SWAP_LIMIT, CONTAINER_NAMES[slot]]
        )

    def _wait_inactive(self, component: str, timeout: int = AGENT_DRAIN_TIMEOUT_SECONDS) -> None:
        deadline = time.monotonic() + timeout
        last_state = "unknown"
        while time.monotonic() < deadline:
            last_state = service_state(component)
            if last_state not in ACTIVE_CONTAINER_STATES:
                return
            time.sleep(2)
        raise SupervisorError(
            f"{CONTAINER_NAMES[component]} did not drain within {timeout} seconds (state: {last_state})"
        )

    def _remember_active_agent_slot(self, slot: str) -> None:
        with self.lock:
            self.active_agent_slot = slot
            self.state["activeAgentSlot"] = slot
            self.state["updatedAt"] = int(time.time())
            self._write_state()

    def _roll_agent(self, new_slot: str | None = None) -> None:
        old_slot = self._current_agent_slot()
        target = new_slot or self._inactive_agent_slot()
        if target not in AGENT_SLOTS:
            raise SupervisorError(f"Unsupported agent slot: {target}")
        if old_slot == target:
            raise SupervisorError(f"Agent slot {target} is already active")
        if service_state(target) in ACTIVE_CONTAINER_STATES:
            raise SupervisorError(f"Target agent slot is still active: {CONTAINER_NAMES[target]}")

        target_project = self._project(target)
        old_project = self._project(old_slot) if old_slot is not None else None
        started = False
        committed = False
        try:
            self._run_pm3(["start", target_project, "--", "--force-recreate"], timeout=900)
            started = True
            # podman-compose currently applies mem_limit but not memswap_limit;
            # enforce the legacy aggregate cap after Compose creates the target.
            self._apply_agent_resource_limits(target)
            self._wait_healthy(target)
            # The new process registers with the gateway before it starts polling. From this
            # point on, new jobs have the new generation while the old worker drains its own.
            self._remember_active_agent_slot(target)
            committed = True
            self._run_pm3(["enable", target_project])
            if old_project is not None:
                self._run_pm3(["disable", old_project])
                self._run_pm3(["stop", old_project], timeout=AGENT_DRAIN_TIMEOUT_SECONDS)
                self._wait_inactive(old_slot)
        except Exception:
            if started and not committed:
                self._try_command(
                    [PM3_BINARY, "stop", target_project],
                    timeout=AGENT_DRAIN_TIMEOUT_SECONDS,
                    cwd=STACK_DIRECTORY,
                )
                self._try_command(
                    [PM3_BINARY, "disable", target_project],
                    cwd=STACK_DIRECTORY,
                )
            raise

    def _pin_compose_image(self, content: str, component: str) -> str:
        repository = IMAGE_REPOSITORIES["agent" if component in AGENT_SLOTS else component]
        tag = f"{repository}:main"
        run_command(["podman", "pull", tag])
        digest = run_command(["podman", "image", "inspect", tag, "--format", "{{.Digest}}"])
        if not digest.startswith("sha256:") or len(digest) != 71:
            raise SupervisorError(f"Invalid digest returned for {repository}")
        return replace_compose_image_line(
            content,
            COMPOSE_SERVICES[component],
            repository,
            f"{repository}@{digest}",
        )

    def _deploy(self, scope: str) -> None:
        components = selected_components(scope)
        target_slot: str | None = None
        if "agent" in components:
            target_slot = self._inactive_agent_slot()
            self._check_agent()

        if not COMPOSE_FILE.is_file():
            raise SupervisorError(f"Missing PM3 Compose file: {COMPOSE_FILE}")
        original = COMPOSE_FILE.read_text()
        updated = original
        if "gateway" in components:
            updated = self._pin_compose_image(updated, "gateway")
        if target_slot is not None:
            updated = self._pin_compose_image(updated, target_slot)

        self._atomic_write(COMPOSE_FILE, updated)
        agent_committed = False
        try:
            if "gateway" in components:
                self._restart_gateway()
            if target_slot is not None:
                self._roll_agent(target_slot)
                agent_committed = True
        except Exception:
            # Once the new slot has registered, it is the live generation. Keep that
            # slot and its image intact so a failed drain never rolls the queue backwards.
            if agent_committed or (target_slot is not None and self.active_agent_slot == target_slot):
                raise
            self._atomic_write(COMPOSE_FILE, original, ".rollback")
            if "gateway" in components:
                self._restart_gateway()
            raise

    def _restart(self, scope: str) -> None:
        components = selected_components(scope)
        if "gateway" in components:
            self._restart_gateway()
        if "agent" in components:
            self._check_agent()
            self._roll_agent()

    def _restart_gateway(self) -> None:
        self._run_pm3(["restart", self._project("gateway"), "--no-build"], timeout=900)
        self._wait_healthy("gateway")

    def _wait_healthy(self, component: str) -> None:
        if component not in CONTAINER_NAMES:
            raise SupervisorError(f"Unsupported health target: {component}")
        container = CONTAINER_NAMES[component]
        deadline = time.monotonic() + HEALTH_TIMEOUT_SECONDS
        last_error = "service did not become healthy"
        while time.monotonic() < deadline:
            active = service_state(component)
            if active == "active":
                health = subprocess.run(
                    ["podman", "healthcheck", "run", container],
                    check=False,
                    capture_output=True,
                    text=True,
                )
                if health.returncode == 0:
                    return
                last_error = health.stderr.strip() or health.stdout.strip() or last_error
            else:
                last_error = active or last_error
            time.sleep(2)
        raise SupervisorError(f"{component} failed health verification: {last_error}")

    def _set_state(
        self,
        state: str,
        operation: str,
        scope: str,
        error: str | None = None,
    ) -> None:
        with self.lock:
            self.state = {
                "state": state,
                "operation": operation,
                "scope": scope,
                "updatedAt": int(time.time()),
                "activeAgentSlot": self.active_agent_slot,
            }
            if error is not None:
                self.state["error"] = error
            self._write_state()

    def _write_state(self) -> None:
        STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary = STATE_PATH.with_suffix(".new")
        temporary.write_text(json.dumps(self.state, ensure_ascii=False) + "\n")
        os.replace(temporary, STATE_PATH)


SUPERVISOR: Supervisor
TOKEN = ""


class RequestHandler(BaseHTTPRequestHandler):
    server_version = "LoylexSupervisor/1"

    def do_GET(self) -> None:
        if not self._authorized():
            self._json(401, {"error": "unauthorized"})
            return
        if self.path != "/v1/status":
            self._json(404, {"error": "not found"})
            return
        self._json(200, SUPERVISOR.status())

    def do_POST(self) -> None:
        if not self._authorized():
            self._json(401, {"error": "unauthorized"})
            return
        parts = self.path.strip("/").split("/")
        if len(parts) != 3 or parts[0] != "v1":
            self._json(404, {"error": "not found"})
            return
        try:
            content_length = int(self.headers.get("content-length", "0"))
            if content_length > 4096:
                self._json(413, {"error": "request too large"})
                return
            payload = json.loads(self.rfile.read(content_length) or b"{}")
            delay_seconds = int(payload.get("delaySeconds", 15))
            result = SUPERVISOR.schedule(parts[1], parts[2], delay_seconds)
            self._json(202, result)
        except BusyError as error:
            self._json(409, {"error": str(error)})
        except (SupervisorError, ValueError, json.JSONDecodeError) as error:
            self._json(400, {"error": str(error)})

    def log_message(self, _: str, *arguments: Any) -> None:
        return

    def _authorized(self) -> bool:
        expected = f"Bearer {TOKEN}"
        supplied = self.headers.get("authorization", "")
        return hmac.compare_digest(supplied, expected)

    def _json(self, status: int, payload: dict[str, Any]) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def main() -> None:
    global SUPERVISOR, TOKEN
    TOKEN = TOKEN_PATH.read_text().strip()
    if not TOKEN:
        raise SupervisorError("Supervisor token is empty")
    SUPERVISOR = Supervisor()
    with ThreadingHTTPServer((LISTEN_HOST, LISTEN_PORT), RequestHandler) as server:
        server.serve_forever()


if __name__ == "__main__":
    main()
