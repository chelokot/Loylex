#!/usr/bin/env bash
set -euo pipefail

umask 077
backup_root="$HOME/backups/loylex"
timestamp="$(date --utc +%Y%m%dT%H%M%SZ)"
destination="$backup_root/$timestamp"
mkdir -p "$backup_root"
find "$backup_root" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf -- {} +
mkdir "$destination"
trap 'rm -rf -- "$destination"' ERR

for volume in loylex-gateway-data loylex-audit loylex-agent-home loylex-memory loylex-workspace; do
  podman volume export "$volume" | zstd -T0 -q -o "$destination/$volume.tar.zst"
done

trap - ERR
